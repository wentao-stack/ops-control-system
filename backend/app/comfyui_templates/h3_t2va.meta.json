{
  "id": "h3_t2va",
  "name": "文生視頻 H3 EXP 4V/10A",
  "description": "MiniMax H3 EXP 取樣：視頻 4 步、音頻 10 次完整 joint H3 呼叫（音頻品質更佳）。",
  "category": "video",
  "icon": "🎬",
  "model": "MiniMax H3 + Turbo LoRA",
  "estimated_time": "約 5-20 分鐘（10 次 H3 呼叫，比 STABLE 4/4 慢約 2.5 倍）",
  "workflow": "h3_t2va.api.json",
  "output_kind": "video",
  "params": [
    {
      "key": "prompt",
      "label": "提示詞",
      "type": "textarea",
      "required": true,
      "help": "描述畫面內容與音效，例如：雨夜、金屬屋頂、同步雨聲，不要音樂。",
      "placeholder": "描述畫面與聲音…",
      "targets": [{"node": "6", "input": "prompt"}]
    },
    {
      "key": "width",
      "label": "寬度",
      "type": "slider",
      "default": 1344,
      "min": 640,
      "max": 1920,
      "step": 64,
      "help": "官方建議 1344×768（16:9），非官方解析度品質會明顯下降",
      "targets": [{"node": "6", "input": "width"}]
    },
    {
      "key": "height",
      "label": "高度",
      "type": "slider",
      "default": 768,
      "min": 384,
      "max": 1088,
      "step": 64,
      "targets": [{"node": "6", "input": "height"}]
    },
    {
      "key": "length",
      "label": "時長",
      "type": "slider",
      "default": 5,
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "秒",
      "help": "建議 ≤5 秒品質最佳（turbo 4 步）；超過 8 秒細節明顯退化。官方上限 15 秒",
      "targets": [{"node": "6", "input": "length", "multiply": 24}]
    },
    {
      "key": "video_steps",
      "label": "視頻步數",
      "type": "slider",
      "default": 4,
      "min": 1,
      "max": 8,
      "step": 1,
      "help": "視頻 Euler 宏步數，EXP 建議 4",
      "targets": [{"node": "7", "input": "video_steps"}]
    },
    {
      "key": "audio_steps",
      "label": "音頻呼叫次數",
      "type": "slider",
      "default": 10,
      "min": 1,
      "max": 20,
      "step": 1,
      "help": "完整 joint H3 DiT 呼叫次數（= 實際模型評估次數）。4/10 ≈ 10 次呼叫，音頻品質比 4/4 好但慢約 2.5 倍",
      "targets": [{"node": "7", "input": "audio_steps"}]
    },
    {
      "key": "seed",
      "label": "種子",
      "type": "seed",
      "default": -1,
      "help": "-1 = 每次隨機",
      "targets": [{"node": "9", "input": "noise_seed"}]
    }
  ]
}
