[Unit]
Description=Ops Control System Dashboard (development)
After=network.target

[Service]
Type=simple
User=wentao
Group=wentao
WorkingDirectory=/home/wentao/project/ops-control-system/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/wentao/project/ops-control-system/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
