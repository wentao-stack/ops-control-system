[Unit]
Description=Ops Control System (Supervisor managed)
After=network.target

[Service]
Type=simple
User=wentao
Group=wentao
WorkingDirectory=/home/wentao/project/ops-control-system
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/wentao/project/ops-control-system/backend/.venv/bin/supervisord -c /home/wentao/project/ops-control-system/supervisor/supervisord.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
